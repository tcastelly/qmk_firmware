{
    "keyboard_name": "Corne EC F072",
    "manufacturer": "Thomas CASTELLY",
    "maintainer": "tcastelly",
    "usb": {
        "vid": "0xFEED",
        "pid": "0xEC42",
        "device_version": "0.0.1",
        "shared_endpoint": {
            "keyboard": true
        }
    },
    "processor": "STM32F072",
    "bootloader": "stm32-dfu",
    "build": {
        "lto": true
    },
    "diode_direction": "COL2ROW",
    "debounce": 0,
    "dynamic_keymap": {
        "layer_count": 10
    },
    "eeprom": {
        "driver": "wear_leveling",
        "wear_leveling": {
            "driver": "embedded_flash",
            "backing_size": 8192
        }
    },
    "features": {
        "bootmagic": false,
        "console": true,
        "extrakey": true,
        "mousekey": true,
        "nkro": true
    },
    "split": {
        "enabled": true,
        "handedness": {
            "pin": "C13"
        },
        "transport": {
            "watchdog": true
        }
    },
    "layouts": {
        "LAYOUT_split_3x6_3": {
            "layout": [
                {"label":"Tab",        "matrix":[0,0], "x":0,  "y":0.3},
                {"label":"Q",          "matrix":[0,1], "x":1,  "y":0.3},
                {"label":"W",          "matrix":[0,2], "x":2,  "y":0.1},
                {"label":"E",          "matrix":[0,3], "x":3,  "y":0},
                {"label":"R",          "matrix":[0,4], "x":4,  "y":0.1},
                {"label":"T",          "matrix":[0,5], "x":5,  "y":0.2},

                {"label":"Y",          "matrix":[4,5], "x":9,  "y":0.2},
                {"label":"U",          "matrix":[4,4], "x":10, "y":0.1},
                {"label":"I",          "matrix":[4,3], "x":11, "y":0},
                {"label":"O",          "matrix":[4,2], "x":12, "y":0.1},
                {"label":"P",          "matrix":[4,1], "x":13, "y":0.3},
                {"label":"Back Space", "matrix":[4,0], "x":14, "y":0.3},

                {"label":"Esc",        "matrix":[1,0], "x":0,  "y":1.3},
                {"label":"A",          "matrix":[1,1], "x":1,  "y":1.3},
                {"label":"S",          "matrix":[1,2], "x":2,  "y":1.1},
                {"label":"D",          "matrix":[1,3], "x":3,  "y":1},
                {"label":"F",          "matrix":[1,4], "x":4,  "y":1.1},
                {"label":"G",          "matrix":[1,5], "x":5,  "y":1.2},

                {"label":"H",          "matrix":[5,5], "x":9,  "y":1.2},
                {"label":"J",          "matrix":[5,4], "x":10, "y":1.1},
                {"label":"K",          "matrix":[5,3], "x":11, "y":1},
                {"label":"L",          "matrix":[5,2], "x":12, "y":1.1},
                {"label":";",          "matrix":[5,1], "x":13, "y":1.3},
                {"label":"'",          "matrix":[5,0], "x":14, "y":1.3},

                {"label":"Shift",      "matrix":[2,0], "x":0,  "y":2.3},
                {"label":"Z",          "matrix":[2,1], "x":1,  "y":2.3},
                {"label":"X",          "matrix":[2,2], "x":2,  "y":2.1},
                {"label":"C",          "matrix":[2,3], "x":3,  "y":2},
                {"label":"V",          "matrix":[2,4], "x":4,  "y":2.1},
                {"label":"B",          "matrix":[2,5], "x":5,  "y":2.2},

                {"label":"N",          "matrix":[6,5], "x":9,  "y":2.2},
                {"label":"M",          "matrix":[6,4], "x":10, "y":2.1},
                {"label":",",          "matrix":[6,3], "x":11, "y":2},
                {"label":".",          "matrix":[6,2], "x":12, "y":2.1},
                {"label":"/",          "matrix":[6,1], "x":13, "y":2.3},
                {"label":"Enter",      "matrix":[6,0], "x":14, "y":2.3},

                {"label":"GUI",        "matrix":[3,3], "x":4,  "y":3.7},
                {"label":"Lower",      "matrix":[3,4], "x":5,  "y":3.7},
                {"label":"Space",      "matrix":[3,5], "x":6,  "y":3.2, "h":1.5},

                {"label":"Enter",      "matrix":[7,5], "x":8,  "y":3.2, "h":1.5},
                {"label":"Raise",      "matrix":[7,4], "x":9,  "y":3.7},
                {"label":"Alt",        "matrix":[7,3], "x":10, "y":3.7}
            ]
        }
    }
}
